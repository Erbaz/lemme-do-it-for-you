# ============================================================
# Model Provider Configuration
# ============================================================
# Choose your model provider: "ollama", "openai", or "openrouter"
# - "ollama"      → uses a local Ollama server (e.g. qwen3-vl:8b-instruct)
# - "openai"      → uses any OpenAI-compatible API (e.g. local GPT server)
# - "openrouter"  → uses OpenRouter (e.g. qwen/qwen3-vl-8b-instruct)
MODEL_PROVIDER=openrouter

# ============================================================
# Model Name
# ============================================================
# Ollama      : qwen3-vl:8b-instruct, qwen2.5-vl:7b-instruct, etc.
# OpenRouter  : qwen/qwen3-vl-8b-instruct, mistralai/mixtral-8x7b-instruct, etc.
# OpenAI      : gpt-4o, gpt-4o-mini, etc.
MODEL_NAME=dots-studio/dots-3-note-preview:free

# ============================================================
# Ollama Settings
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# OpenAI / OpenRouter Settings
# ============================================================
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# Common LLM Settings
# ============================================================
CONTEXT_WINDOW=262144
REQUEST_TIMEOUT=120.0
MAX_TOKENS=4096
